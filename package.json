{
  "name": "back",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "migrate-prod": "node build/ace migration:run",
    "seed-prod": "node build/ace db:seed",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --strict",
    "typecheck:watch": "tsc --noEmit --watch",
    "build:check": "tsc --noEmit && node ace build",
    "lint:strict": "eslint . --max-warnings 0",
    "validate": "npm run typecheck:strict && npm run lint:strict",
    "pre-deploy": "npm run validate && npm run build:check",
    "save-uploads": "node ./bin/preserve.cjs",
    "load-uploads": "node ./bin/restore.cjs"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.5.2",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/prettier-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@japa/api-client": "^2.0.3",
    "@japa/assert": "^3.0.0",
    "@japa/plugin-adonisjs": "^3.0.1",
    "@japa/runner": "^3.1.4",
    "@swc/core": "^1.13.2",
    "@swc/helpers": "^0.5.17",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.12.10",
    "@types/string-similarity": "^4.0.2",
    "@types/supertest": "^7.2.0",
    "eslint": "^8.57.0",
    "hot-hook": "^0.2.5",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.4"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.3",
    "@adonisjs/bouncer": "^3.1.2",
    "@adonisjs/core": "^6.12.1",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.2.0",
    "@adonisjs/mail": "^9.2.1",
    "@vinejs/vine": "^2.1.0",
    "adonisjs-filters": "^1.0.5",
    "luxon": "^3.5.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "string-similarity": "^4.0.4"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
